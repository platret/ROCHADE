{
  "expo": {
    "name": "ROCHADE",
    "slug": "rochade",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rochade",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ch.rochade.app",
      "supportsTablet": false,
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "appleTeamId": "9R9YA6B34L",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ch.rochade.app",
      "adaptiveIcon": {
        "backgroundColor": "#F26A1B",
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/icon-tinted.png"
      },
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF8F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#14191B",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-calendar",
        {
          "calendarPermission": "ROCHADE trägt deine Umzugstermine in deinen Kalender ein."
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "688ae889-1d3f-42eb-900c-1479d988bdd9"
      }
    },
    "owner": "platret"
  }
}
