{
  "name": "rochade",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "mobile": "npm run start -w apps/mobile",
    "web": "npm run dev -w apps/web",
    "seed:sql": "npm run seed:sql -w packages/shared"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
